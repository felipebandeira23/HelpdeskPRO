generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  TECHNICIAN
  VIEWER
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING
  CLOSED
  PAUSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum FollowupOrigin {
  HELPDESK
  PORTAL
  EMAIL
}

enum AgentStatus {
  ONLINE
  OFFLINE
  UNKNOWN
}

enum SLAStatus {
  OK
  WARNING
  BREACHED
}

enum ChecklistItemStatus {
  PENDING
  COMPLETED
}

enum NotificationType {
  TICKET_ASSIGNED
  TICKET_FOLLOWUP
  TICKET_CLOSED
  TICKET_PAUSED
  SLA_WARNING
  SLA_BREACHED
  FOLLOWER_ADDED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      UserRole @default(VIEWER)
  active    Boolean  @default(true)

  createdTickets    Ticket[]        @relation("createdBy")
  assignedTickets   Ticket[]        @relation("assignedTo")
  followups         TicketFollowup[]
  groupMemberships  GroupMember[]
  auditLogs         AuditLog[]
  tasks             Task[]          @relation("taskAssignee")
  vaultCredentials  VaultCredential[] @relation("vaultOwner")
  followedTickets   TicketFollower[]
  notifications     Notification[]
  attachments       Attachment[]
  ratings           TicketRating[]  @relation("ratingAuthor")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Group {
  id    String @id @default(cuid())
  name  String
  description String?

  tickets       Ticket[]
  members       GroupMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("groups")
}

model GroupMember {
  id      String @id @default(cuid())
  groupId String
  userId  String

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([groupId, userId])
  @@map("group_members")
}

model Ticket {
  id           String   @id @default(cuid())
  ticketNumber Int      @unique @default(autoincrement())
  title        String
  description String
  status      TicketStatus @default(OPEN)
  priority    TicketPriority @default(MEDIUM)
  progress    Int      @default(0) @db.SmallInt

  // Motivo informado pelo operador ao pausar (padrão Milvus)
  pauseReason String?
  pausedAt    DateTime?

  // Primeira resposta pública de um operador — base do SLA de resposta
  firstResponseAt DateTime?

  requesterId String
  requester   User   @relation("createdBy", fields: [requesterId], references: [id], onDelete: Restrict)

  assignedToId String?
  assignedTo   User?  @relation("assignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)

  groupId String?
  group   Group?  @relation(fields: [groupId], references: [id], onDelete: SetNull)

  assetId String?
  asset   Asset?  @relation(fields: [assetId], references: [id], onDelete: SetNull)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  followups   TicketFollowup[]
  sla         SLA?
  checklist   Checklist?
  followers   TicketFollower[]
  attachments Attachment[]
  rating      TicketRating?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  closedAt  DateTime?

  @@index([requesterId])
  @@index([assignedToId])
  @@index([groupId])
  @@index([status])
  @@index([priority])
  @@index([categoryId])
  @@index([customerId])
  @@map("tickets")
}

model TicketFollowup {
  id        String @id @default(cuid())
  ticketId  String
  ticket    Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  message     String
  isInternal  Boolean @default(false)
  origin      FollowupOrigin @default(HELPDESK)

  attachments Attachment[]

  createdAt DateTime @default(now())

  @@index([ticketId])
  @@index([authorId])
  @@map("ticket_followups")
}

model Asset {
  id        String @id @default(cuid())
  hostname  String @unique
  ip        String?

  manufacturer String?
  model        String?
  os           String?

  agentStatus AgentStatus @default(UNKNOWN)
  lastSeen    DateTime?

  tickets   Ticket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agentStatus])
  @@map("assets")
}

model TicketType {
  id    String @id @default(cuid())
  name  String @unique
  icon  String?
  color String @default("#2B73C9")
  description String?

  slaResponseTime    Int?
  slaSolutionTime    Int?

  checklistTemplateId String?
  checklistTemplate   ChecklistTemplate? @relation(fields: [checklistTemplateId], references: [id])

  templates TicketTemplate[] @relation("TicketTypeTemplates")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ticket_types")
}

model TicketTemplate {
  id    String @id @default(cuid())
  name  String
  description String?

  typeId  String?
  type    TicketType?  @relation("TicketTypeTemplates", fields: [typeId], references: [id], onDelete: SetNull)

  defaultPriority TicketPriority @default(MEDIUM)
  defaultTitle    String?
  defaultDescription String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([typeId])
  @@map("ticket_templates")
}

model SLA {
  id        String @id @default(cuid())
  ticketId  String @unique
  ticket    Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  policyId  String?
  policy    SlaPolicy? @relation(fields: [policyId], references: [id], onDelete: SetNull)

  responseTime    DateTime?
  responseStatus  SLAStatus @default(OK)
  respondedAt     DateTime?

  solutionTime    DateTime?
  solutionStatus  SLAStatus @default(OK)
  solvedAt        DateTime?

  // Pausa do contador: enquanto pausedAt != null o relógio não corre.
  // Ao retomar, os prazos são deslocados pelo tempo pausado.
  // Int (minutos) e não BigInt: BigInt quebra a serialização JSON padrão.
  pausedAt           DateTime?
  totalPausedMinutes Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ticketId])
  @@index([responseStatus])
  @@index([solutionStatus])
  @@map("slas")
}

model SlaPolicy {
  id   String @id @default(cuid())
  name String

  // Escopo: combinação categoria+prioridade > categoria > prioridade > global (ambos null)
  priority   TicketPriority?
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  responseMinutes Int
  solutionMinutes Int

  // Se true, prazos contam apenas dentro do expediente e fora de feriados
  businessHoursOnly Boolean @default(true)
  active            Boolean @default(true)

  slas SLA[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([priority, categoryId])
  @@index([active])
  @@map("sla_policies")
}

model BusinessHours {
  id      String  @id @default(cuid())
  weekday Int     // 0 = domingo ... 6 = sábado
  start   String  // "08:00"
  end     String  // "18:00"
  enabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([weekday])
  @@map("business_hours")
}

model Holiday {
  id        String   @id @default(cuid())
  name      String
  date      DateTime @db.Date
  recurring Boolean  @default(false) // repete todo ano (ex: Natal)

  createdAt DateTime @default(now())

  @@index([date])
  @@map("holidays")
}

model Category {
  id          String  @id @default(cuid())
  name        String
  description String?
  color       String  @default("#2B73C9")
  active      Boolean @default(true)

  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")

  tickets     Ticket[]
  slaPolicies SlaPolicy[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, parentId])
  @@index([parentId])
  @@index([active])
  @@map("categories")
}

model TicketFollower {
  id       String @id @default(cuid())
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([ticketId, userId])
  @@index([userId])
  @@map("ticket_followers")
}

model Attachment {
  id           String @id @default(cuid())
  filename     String // nome no disco (uuid)
  originalName String
  mimeType     String
  size         Int

  ticketId String?
  ticket   Ticket? @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  followupId String?
  followup   TicketFollowup? @relation(fields: [followupId], references: [id], onDelete: Cascade)

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([ticketId])
  @@index([followupId])
  @@map("attachments")
}

model Notification {
  id     String           @id @default(cuid())
  userId String
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type   NotificationType
  title  String
  message String
  link   String? // rota no frontend, ex: /tickets/abc
  read   Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([createdAt])
  @@map("notifications")
}

model TicketRating {
  id       String @id @default(cuid())
  ticketId String @unique
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  raterId String
  rater   User   @relation("ratingAuthor", fields: [raterId], references: [id], onDelete: Restrict)

  rating  Int // 1-5
  comment String?

  createdAt DateTime @default(now())

  @@index([rating])
  @@map("ticket_ratings")
}

model ChecklistTemplate {
  id          String @id @default(cuid())
  name        String
  description String?

  items ChecklistTemplateItem[]

  ticketTypes TicketType[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("checklist_templates")
}

model ChecklistTemplateItem {
  id          String @id @default(cuid())
  templateId  String
  template    ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  title       String
  description String?
  order       Int @default(0)

  createdAt DateTime @default(now())

  @@index([templateId])
  @@map("checklist_template_items")
}

model Checklist {
  id        String @id @default(cuid())
  ticketId  String
  ticket    Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  items ChecklistItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ticketId])
  @@map("checklists")
}

model ChecklistItem {
  id          String @id @default(cuid())
  checklistId String
  checklist   Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  title       String
  description String?
  status      ChecklistItemStatus @default(PENDING)
  order       Int @default(0)

  completedAt DateTime?
  completedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([checklistId])
  @@index([status])
  @@map("checklist_items")
}

model AutomationRule {
  id          String @id @default(cuid())
  name        String
  description String?

  trigger     String // "ticket_created", "ticket_updated", "sla_warning", etc
  conditions  Json   // Filter conditions
  actions     Json   // Actions to execute
  enabled     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([trigger])
  @@index([enabled])
  @@map("automation_rules")
}

model AuditLog {
  id        String @id @default(cuid())
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  action    String
  module    String
  recordId  String?
  changes   Json?

  ip        String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([module])
  @@index([createdAt])
  @@map("audit_logs")
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  DONE
  CANCELLED
}

model Customer {
  id        String  @id @default(cuid())
  name      String
  document  String? // CNPJ/CPF
  email     String?
  phone     String?
  address   String?
  contractStatus String @default("NONE") // NONE | ACTIVE | EXPIRING | OVERDUE
  notes     String?

  tickets Ticket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("customers")
}

model Task {
  id          String @id @default(cuid())
  title       String
  description String?
  status      TaskStatus @default(PENDING)

  assigneeId  String?
  assignee    User?  @relation("taskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  dueDate     DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assigneeId])
  @@index([status])
  @@map("tasks")
}

model VaultCredential {
  id        String @id @default(cuid())
  name      String
  username  String
  password  String // encrypted at rest
  url       String?
  notes     String?

  ownerId   String
  owner     User   @relation("vaultOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@map("vault_credentials")
}
