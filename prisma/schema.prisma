generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProfileInterface {
  CENTRAL
  SIMPLIFIED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING
  PAUSED
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum FollowupOrigin {
  HELPDESK
  PORTAL
  EMAIL
}

enum TicketKind {
  INCIDENT
  REQUEST
  PROBLEM
  CHANGE
}

enum TicketUrgency {
  VERY_LOW
  LOW
  MEDIUM
  HIGH
  VERY_HIGH
}

enum TicketImpact {
  VERY_LOW
  LOW
  MEDIUM
  HIGH
  VERY_HIGH
}

enum SolutionStatus {
  PENDING_APPROVAL
  APPROVED
  REFUSED
  CLOSED
}

enum ValidationStatus {
  PENDING
  APPROVED
  REFUSED
}

enum TicketRelationType {
  LINKED
  DUPLICATE
  PARENT_CHILD
  CAUSED_BY
  CAUSES
}

enum AgentStatus {
  ONLINE
  OFFLINE
  UNKNOWN
}

enum AssetType {
  COMPUTER
  LAPTOP
  SERVER
  PRINTER
  SWITCH
  ROUTER
  PHONE
  TABLET
  MONITOR
  ACCESS_POINT
  NETWORK_EQUIPMENT
  PERIPHERAL
  CARTRIDGE
  CONSUMABLE
  RACK
  ENCLOSURE
  PDU
  PASSIVE_DEVICE
  CABLE
  OTHER
}

enum AssetStatus {
  IN_USE
  AVAILABLE
  MAINTENANCE
  RETIRED
  STOLEN
  LENT
}

enum ComponentType {
  CPU
  RAM
  STORAGE
  GPU
  NETWORK_CARD
  MOTHERBOARD
  POWER_SUPPLY
  BATTERY
  SCREEN
  OTHER
}

enum SLAStatus {
  OK
  WARNING
  BREACHED
}

enum ChecklistItemStatus {
  PENDING
  COMPLETED
}

enum NotificationType {
  TICKET_ASSIGNED
  TICKET_FOLLOWUP
  TICKET_CLOSED
  TICKET_PAUSED
  SLA_WARNING
  SLA_BREACHED
  FOLLOWER_ADDED
  SURVEY_REQUEST
  SYSTEM
}

enum CronTaskStatus {
  SCHEDULED
  DISABLED
  RUNNING
}

enum CronRunStatus {
  SUCCESS
  ERROR
  SKIPPED
}

enum ChatStatus {
  WAITING
  ACTIVE
  CLOSED
  CONVERTED_TO_TICKET
}

enum ChatSenderType {
  USER
  TECHNICIAN
  SYSTEM
}

enum ChatParticipantRole {
  REQUESTER
  TECHNICIAN
}

model Profile {
  id                String           @id @default(cuid())
  name              String           @unique
  interface         ProfileInterface @default(CENTRAL)
  isDefault         Boolean          @default(false)
  twoFactorEnforced Boolean          @default(false)
  comment           String?

  rights ProfileRight[]
  users  User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("profiles")
}

model ProfileRight {
  id        String  @id @default(cuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  name   String
  rights Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([profileId, name])
  @@index([profileId])
  @@map("profile_rights")
}

model User {
  id       String  @id @default(cuid())
  email    String  @unique
  name     String
  password String
  active   Boolean @default(true)

  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Restrict)

  createdTickets    Ticket[]           @relation("createdBy")
  assignedTickets   Ticket[]           @relation("assignedTo")
  followups         TicketFollowup[]
  groupMemberships  GroupMember[]
  auditLogs         AuditLog[]
  tasks             Task[]             @relation("taskAssignee")
  ticketTasks       TicketTask[]
  ticketValidations TicketValidation[]
  vaultCredentials  VaultCredential[]  @relation("vaultOwner")
  followedTickets   TicketFollower[]
  notifications     Notification[]
  attachments       Attachment[]
  ratings           TicketRating[]     @relation("ratingAuthor")
  assetsTech        Asset[]            @relation("AssetTechnician")
  assetsUser        Asset[]            @relation("AssetUser")
  systemSettings    SystemSetting[]
  chatParticipants  ChatParticipant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileId])
  @@map("users")
}

model Group {
  id          String  @id @default(cuid())
  name        String
  description String?

  tickets Ticket[]
  members GroupMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("groups")
}

model GroupMember {
  id      String @id @default(cuid())
  groupId String
  userId  String

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([groupId, userId])
  @@map("group_members")
}

model Ticket {
  id           String         @id @default(cuid())
  ticketNumber Int            @unique @default(autoincrement())
  title        String
  description  String
  status       TicketStatus   @default(OPEN)
  priority     TicketPriority @default(MEDIUM)
  progress     Int            @default(0) @db.SmallInt

  kind    TicketKind    @default(INCIDENT)
  urgency TicketUrgency @default(MEDIUM)
  impact  TicketImpact  @default(MEDIUM)

  externalId    String?
  openedAt      DateTime?
  totalDuration Int?

  pauseReason String?
  pausedAt    DateTime?

  firstResponseAt DateTime?

  resolvedAt DateTime?

  requesterId String
  requester   User   @relation("createdBy", fields: [requesterId], references: [id], onDelete: Restrict)

  assignedToId String?
  assignedTo   User?   @relation("assignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)

  groupId String?
  group   Group?  @relation(fields: [groupId], references: [id], onDelete: SetNull)

  assetId String?
  asset   Asset?  @relation(fields: [assetId], references: [id], onDelete: SetNull)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  locationId String?

  followups        TicketFollowup[]
  tasks            TicketTask[]
  costs            TicketCost[]
  solutions        TicketSolution[]
  validations      TicketValidation[]
  relations        TicketRelation[]
  relatedFrom      TicketRelation[]   @relation("RelatedFrom")
  sla              SLA?
  checklist        Checklist?
  followers        TicketFollower[]
  attachments      Attachment[]
  rating           TicketRating?
  chatConversation ChatConversation?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  closedAt  DateTime?

  @@index([requesterId])
  @@index([assignedToId])
  @@index([groupId])
  @@index([status])
  @@index([priority])
  @@index([categoryId])
  @@index([customerId])
  @@map("tickets")
}

model TicketFollowup {
  id       String @id @default(cuid())
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  message    String
  isInternal Boolean        @default(false)
  origin     FollowupOrigin @default(HELPDESK)

  attachments Attachment[]

  createdAt DateTime @default(now())

  @@index([ticketId])
  @@index([authorId])
  @@map("ticket_followups")
}

model TicketTask {
  id       String @id @default(cuid())
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  content String
  isDone  Boolean @default(false)

  assignedToId String?
  assignedTo   User?   @relation(fields: [assignedToId], references: [id], onDelete: SetNull)

  actionTime Int?
  plannedAt  DateTime?
  plannedEnd DateTime?
  isPrivate  Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ticketId])
  @@index([assignedToId])
  @@map("ticket_tasks")
}

model TicketCost {
  id       String @id @default(cuid())
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  costTime     Float?
  actionTime   Int?
  costFixed    Float?
  costMaterial Float?

  createdAt DateTime @default(now())

  @@index([ticketId])
  @@map("ticket_costs")
}

model TicketSolution {
  id       String @id @default(cuid())
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  content       String
  status        SolutionStatus @default(PENDING_APPROVAL)
  refusalReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ticketId])
  @@map("ticket_solutions")
}

model TicketValidation {
  id       String @id @default(cuid())
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  content String
  status  ValidationStatus @default(PENDING)

  validatorId String?
  validator   User?   @relation(fields: [validatorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ticketId])
  @@index([validatorId])
  @@map("ticket_validations")
}

model TicketRelation {
  id       String @id @default(cuid())
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  relatedTicketId String
  relatedTicket   Ticket @relation("RelatedFrom", fields: [relatedTicketId], references: [id], onDelete: Cascade)

  type TicketRelationType

  createdAt DateTime @default(now())

  @@unique([ticketId, relatedTicketId])
  @@index([ticketId])
  @@index([relatedTicketId])
  @@map("ticket_relations")
}

model Asset {
  id       String  @id @default(cuid())
  hostname String  @unique
  ip       String?

  manufacturer String?
  model        String?
  os           String?

  assetType       AssetType   @default(COMPUTER)
  assetStatus     AssetStatus @default(IN_USE)
  serialNumber    String?
  inventoryNumber String?
  uuid            String?
  comments        String?
  specs           Json?

  technicianId String?
  technician   User?   @relation("AssetTechnician", fields: [technicianId], references: [id], onDelete: SetNull)

  userId    String?
  assetUser User?   @relation("AssetUser", fields: [userId], references: [id], onDelete: SetNull)

  agentStatus AgentStatus @default(UNKNOWN)
  lastSeen    DateTime?

  operatingSystems AssetOS[]
  components       AssetComponent[]
  softwareList     AssetSoftware[]
  volumes          AssetVolume[]
  networkPorts     AssetNetworkPort[]
  telemetry        AssetTelemetry[]

  connectionsAsParent AssetConnection[] @relation("ConnParent")
  connectionsAsChild  AssetConnection[] @relation("ConnChild")

  tickets Ticket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agentStatus])
  @@index([assetType])
  @@index([assetStatus])
  @@map("assets")
}

model AssetOS {
  id           String    @id @default(cuid())
  assetId      String
  asset        Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  name         String
  version      String?
  architecture String?
  serialNumber String?
  installDate  DateTime?
  createdAt    DateTime  @default(now())

  @@index([assetId])
  @@map("asset_os")
}

model AssetComponent {
  id           String        @id @default(cuid())
  assetId      String
  asset        Asset         @relation(fields: [assetId], references: [id], onDelete: Cascade)
  type         ComponentType
  name         String
  brand        String?
  model        String?
  serialNumber String?
  quantity     Int           @default(1)
  specs        String?
  createdAt    DateTime      @default(now())

  @@index([assetId])
  @@map("asset_components")
}

model AssetSoftware {
  id          String    @id @default(cuid())
  assetId     String
  asset       Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  name        String
  version     String?
  vendor      String?
  installDate DateTime?
  createdAt   DateTime  @default(now())

  @@index([assetId])
  @@map("asset_software")
}

model AssetVolume {
  id         String   @id @default(cuid())
  assetId    String
  asset      Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  name       String
  mountPoint String?
  fileSystem String?
  totalGB    Float?
  freeGB     Float?
  createdAt  DateTime @default(now())

  @@index([assetId])
  @@map("asset_volumes")
}

model AssetNetworkPort {
  id         String   @id @default(cuid())
  assetId    String
  asset      Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  name       String
  macAddress String?
  speed      String?
  ipAddress  String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([assetId])
  @@map("asset_network_ports")
}

model AssetTelemetry {
  id          String   @id @default(cuid())
  assetId     String
  asset       Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  cpuUsage    Float?
  memoryUsed  Float?
  memoryTotal Float?
  diskUsage   Json?
  networkIn   Float?
  networkOut  Float?
  uptime      Int?
  processes   Int?
  temperature Float?
  recordedAt  DateTime @default(now())

  @@index([assetId, recordedAt])
  @@map("asset_telemetry")
}

model TicketType {
  id          String  @id @default(cuid())
  name        String  @unique
  icon        String?
  color       String  @default("#2B73C9")
  description String?

  slaResponseTime Int?
  slaSolutionTime Int?

  checklistTemplateId String?
  checklistTemplate   ChecklistTemplate? @relation(fields: [checklistTemplateId], references: [id])

  templates TicketTemplate[] @relation("TicketTypeTemplates")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ticket_types")
}

model TicketTemplate {
  id          String  @id @default(cuid())
  name        String
  description String?

  typeId String?
  type   TicketType? @relation("TicketTypeTemplates", fields: [typeId], references: [id], onDelete: SetNull)

  defaultPriority    TicketPriority @default(MEDIUM)
  defaultTitle       String?
  defaultDescription String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([typeId])
  @@map("ticket_templates")
}

model SLA {
  id       String @id @default(cuid())
  ticketId String @unique
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  policyId String?
  policy   SlaPolicy? @relation(fields: [policyId], references: [id], onDelete: SetNull)

  responseTime   DateTime?
  responseStatus SLAStatus @default(OK)
  respondedAt    DateTime?

  solutionTime   DateTime?
  solutionStatus SLAStatus @default(OK)
  solvedAt       DateTime?

  pausedAt           DateTime?
  totalPausedMinutes Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ticketId])
  @@index([responseStatus])
  @@index([solutionStatus])
  @@map("slas")
}

model SlaPolicy {
  id   String @id @default(cuid())
  name String

  priority   TicketPriority?
  categoryId String?
  category   Category?       @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  responseMinutes Int
  solutionMinutes Int

  businessHoursOnly Boolean @default(true)
  active            Boolean @default(true)

  slas SLA[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([priority, categoryId])
  @@index([active])
  @@map("sla_policies")
}

model BusinessHours {
  id      String  @id @default(cuid())
  weekday Int
  start   String
  end     String
  enabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([weekday])
  @@map("business_hours")
}

model Holiday {
  id        String   @id @default(cuid())
  name      String
  date      DateTime @db.Date
  recurring Boolean  @default(false)

  createdAt DateTime @default(now())

  @@index([date])
  @@map("holidays")
}

model Category {
  id          String  @id @default(cuid())
  name        String
  description String?
  color       String  @default("#2B73C9")
  active      Boolean @default(true)

  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")

  tickets     Ticket[]
  slaPolicies SlaPolicy[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, parentId])
  @@index([parentId])
  @@index([active])
  @@map("categories")
}

model TicketFollower {
  id       String @id @default(cuid())
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([ticketId, userId])
  @@index([userId])
  @@map("ticket_followers")
}

model Attachment {
  id           String @id @default(cuid())
  filename     String
  originalName String
  mimeType     String
  size         Int

  ticketId String?
  ticket   Ticket? @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  followupId String?
  followup   TicketFollowup? @relation(fields: [followupId], references: [id], onDelete: Cascade)

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([ticketId])
  @@index([followupId])
  @@map("attachments")
}

model Notification {
  id      String           @id @default(cuid())
  userId  String
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type    NotificationType
  title   String
  message String
  link    String?
  read    Boolean          @default(false)

  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([createdAt])
  @@map("notifications")
}

model TicketRating {
  id       String @id @default(cuid())
  ticketId String @unique
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  raterId String
  rater   User   @relation("ratingAuthor", fields: [raterId], references: [id], onDelete: Restrict)

  rating  Int
  comment String?

  createdAt DateTime @default(now())

  @@index([rating])
  @@map("ticket_ratings")
}

model ChecklistTemplate {
  id          String  @id @default(cuid())
  name        String
  description String?

  items ChecklistTemplateItem[]

  ticketTypes TicketType[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("checklist_templates")
}

model ChecklistTemplateItem {
  id         String            @id @default(cuid())
  templateId String
  template   ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  title       String
  description String?
  order       Int     @default(0)

  createdAt DateTime @default(now())

  @@index([templateId])
  @@map("checklist_template_items")
}

model Checklist {
  id       String @id @default(cuid())
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  items ChecklistItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ticketId])
  @@map("checklists")
}

model ChecklistItem {
  id          String    @id @default(cuid())
  checklistId String
  checklist   Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  title       String
  description String?
  status      ChecklistItemStatus @default(PENDING)
  order       Int                 @default(0)

  completedAt DateTime?
  completedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([checklistId])
  @@index([status])
  @@map("checklist_items")
}

model AutomationRule {
  id          String  @id @default(cuid())
  name        String
  description String?

  trigger    String
  conditions Json
  actions    Json
  enabled    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([trigger])
  @@index([enabled])
  @@map("automation_rules")
}

model AuditLog {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  action   String
  module   String
  recordId String?
  changes  Json?

  ip String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([module])
  @@index([createdAt])
  @@map("audit_logs")
}

model CronTask {
  id           String         @id @default(cuid())
  name         String         @unique
  label        String
  description  String
  itemType     String
  status       CronTaskStatus @default(SCHEDULED)
  frequency    Int
  runStartHour Int            @default(0)
  runEndHour   Int            @default(24)
  param        Json?
  lastRun      DateTime?
  lastDuration Int?
  lastStatus   CronRunStatus?
  lastMessage  String?
  nextRun      DateTime?

  logs CronTaskLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("cron_tasks")
}

model CronTaskLog {
  id        String        @id @default(cuid())
  taskId    String
  task      CronTask      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  status    CronRunStatus
  message   String
  duration  Int
  startedAt DateTime
  createdAt DateTime      @default(now())

  @@index([taskId])
  @@index([createdAt])
  @@map("cron_task_logs")
}

model RecurringTicket {
  id           String         @id @default(cuid())
  title        String
  description  String
  priority     TicketPriority @default(MEDIUM)
  categoryId   String?
  assignedToId String?
  requesterId  String
  frequency    Int
  enabled      Boolean        @default(true)
  lastRun      DateTime?
  nextRun      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("recurring_tickets")
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  DONE
  CANCELLED
}

model Customer {
  id             String    @id @default(cuid())
  name           String
  document       String?
  email          String?
  phone          String?
  address        String?
  contractStatus String    @default("NONE")
  contractEnd    DateTime?
  notes          String?

  tickets Ticket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("customers")
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String?
  status      TaskStatus @default(PENDING)

  assigneeId String?
  assignee   User?   @relation("taskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  dueDate     DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assigneeId])
  @@index([status])
  @@map("tasks")
}

model VaultCredential {
  id       String  @id @default(cuid())
  name     String
  username String
  password String
  url      String?
  notes    String?

  ownerId String
  owner   User   @relation("vaultOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@map("vault_credentials")
}

model SystemSetting {
  id          String  @id @default(cuid())
  category    String  @unique
  data        Json    @default("{}")
  updatedById String?
  updatedBy   User?   @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@map("system_settings")
}

enum AgentOS {
  WINDOWS
  LINUX
  MACOS
  UNKNOWN
}

enum UnmanagedStatus {
  NEW
  ACKNOWLEDGED
  IMPORTED
  IGNORED
}

enum ScanRunStatus {
  RUNNING
  SUCCESS
  ERROR
}

enum AssetConnectionKind {
  DIRECT
  NETWORK
  POWER
}

model Agent {
  id           String      @id @default(cuid())
  token        String      @unique
  hostname     String      @unique
  ip           String?
  os           AgentOS     @default(UNKNOWN)
  version      String?
  status       AgentStatus @default(UNKNOWN)
  config       Json        @default("{}")
  lastSeen     DateTime?
  registeredAt DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([status])
  @@index([lastSeen])
  @@map("agents")
}

model AssetConnection {
  id       String @id @default(cuid())
  parentId String
  parent   Asset  @relation("ConnParent", fields: [parentId], references: [id], onDelete: Cascade)

  childId String
  child   Asset  @relation("ConnChild", fields: [childId], references: [id], onDelete: Cascade)

  kind AssetConnectionKind @default(DIRECT)

  createdAt DateTime @default(now())

  @@unique([parentId, childId])
  @@index([parentId])
  @@index([childId])
  @@map("asset_connections")
}

model UnmanagedDevice {
  id                String  @id @default(cuid())
  ip                String  @unique
  mac               String?
  hostname          String?
  vendor            String?
  sysName           String?
  sysDescr          String?
  connectedSwitchIp String?
  switchPort        String?

  status          UnmanagedStatus @default(NEW)
  importedAssetId String?
  rawData         Json?

  firstSeen DateTime @default(now())
  lastSeen  DateTime @default(now())
  scanRunId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([scanRunId])
  @@index([lastSeen])
  @@map("unmanaged_devices")
}

model NetworkScanRun {
  id           String        @id @default(cuid())
  subnet       String
  status       ScanRunStatus
  hostsAlive   Int           @default(0)
  devicesFound Int           @default(0)
  newDevices   Int           @default(0)

  startedAt   DateTime
  finishedAt  DateTime?
  error       String?
  triggeredBy String?

  createdAt DateTime @default(now())

  @@index([status])
  @@index([startedAt])
  @@map("network_scan_runs")
}

model ChatConversation {
  id      String     @id @default(cuid())
  status  ChatStatus @default(WAITING)
  channel String     @default("DESKTOP_AGENT")

  ticketId String? @unique
  ticket   Ticket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  messages     ChatMessage[]
  participants ChatParticipant[]

  createdAt DateTime  @default(now())
  closedAt  DateTime?
  updatedAt DateTime  @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([ticketId])
  @@map("chat_conversations")
}

model ChatMessage {
  id             String           @id @default(cuid())
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderType ChatSenderType
  senderName String
  senderId   String?
  content    String

  createdAt DateTime @default(now())

  @@index([conversationId])
  @@index([createdAt])
  @@map("chat_messages")
}

model ChatParticipant {
  id             String           @id @default(cuid())
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  externalName  String?
  externalEmail String?

  role ChatParticipantRole

  joinedAt DateTime @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("chat_participants")
}
