generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  TECHNICIAN
  VIEWER
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING
  CLOSED
  PAUSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum FollowupOrigin {
  HELPDESK
  PORTAL
  EMAIL
}

enum AgentStatus {
  ONLINE
  OFFLINE
  UNKNOWN
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      UserRole @default(VIEWER)
  active    Boolean  @default(true)

  createdTickets    Ticket[]        @relation("createdBy")
  assignedTickets   Ticket[]        @relation("assignedTo")
  followups         TicketFollowup[]
  groupMemberships  GroupMember[]
  auditLogs         AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Group {
  id    String @id @default(cuid())
  name  String
  description String?

  tickets       Ticket[]
  members       GroupMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("groups")
}

model GroupMember {
  id      String @id @default(cuid())
  groupId String
  userId  String

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([groupId, userId])
  @@map("group_members")
}

model Ticket {
  id          String   @id @default(cuid())
  title       String
  description String
  status      TicketStatus @default(OPEN)
  priority    TicketPriority @default(MEDIUM)
  progress    Int      @default(0) @db.SmallInt

  requesterId String
  requester   User   @relation("createdBy", fields: [requesterId], references: [id], onDelete: Restrict)

  assignedToId String?
  assignedTo   User?  @relation("assignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)

  groupId String?
  group   Group?  @relation(fields: [groupId], references: [id], onDelete: SetNull)

  assetId String?
  asset   Asset?  @relation(fields: [assetId], references: [id], onDelete: SetNull)

  followups TicketFollowup[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  closedAt  DateTime?

  @@index([requesterId])
  @@index([assignedToId])
  @@index([groupId])
  @@index([status])
  @@index([priority])
  @@map("tickets")
}

model TicketFollowup {
  id        String @id @default(cuid())
  ticketId  String
  ticket    Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  message     String
  isInternal  Boolean @default(false)
  origin      FollowupOrigin @default(HELPDESK)

  createdAt DateTime @default(now())

  @@index([ticketId])
  @@index([authorId])
  @@map("ticket_followups")
}

model Asset {
  id        String @id @default(cuid())
  hostname  String @unique
  ip        String?

  manufacturer String?
  model        String?
  os           String?

  agentStatus AgentStatus @default(UNKNOWN)
  lastSeen    DateTime?

  tickets   Ticket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agentStatus])
  @@map("assets")
}

model AuditLog {
  id        String @id @default(cuid())
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  action    String
  module    String
  recordId  String?
  changes   Json?

  ip        String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([module])
  @@index([createdAt])
  @@map("audit_logs")
}
